# ===================================
# OPPEX Application - Environment Variables Template
# ===================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control
# ===================================

# ===================================
# DATABASE CONFIGURATION (Neon DB)
# ===================================
NEON_DB_URL=jdbc:postgresql://your-neon-host.neon.tech:5432/neondb?sslmode=require
NEON_DB_USER=your_database_user
NEON_DB_PASSWORD=your_database_password

# ===================================
# QUARKUS BACKEND CONFIGURATION
# ===================================
# Database connection (mapped from NEON_DB_* in docker-compose)
QUARKUS_DATASOURCE_JDBC_URL=${NEON_DB_URL}
QUARKUS_DATASOURCE_USERNAME=${NEON_DB_USER}
QUARKUS_DATASOURCE_PASSWORD=${NEON_DB_PASSWORD}

# HTTP Port (default: 8080 for Docker, 8081 for local dev)
QUARKUS_HTTP_PORT=8080

# CORS Origins - Add your production domain/IP
# Example: http://localhost:3000,http://localhost:3001,http://54.123.45.67
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===================================
# SESSION CONFIGURATION
# ===================================
# Generate a strong random secret for production (minimum 32 characters)
# Use: openssl rand -base64 32
# Or online: https://www.random.org/strings/
SESSION_SECRET=CHANGE-ME-TO-STRONG-RANDOM-SECRET-MINIMUM-32-CHARS

# ===================================
# SMTP CONFIGURATION (Email Service)
# ===================================
# Option 1: Gmail (requires App Password with 2FA enabled)
#   - Go to: https://myaccount.google.com/apppasswords
#   - Generate new app password for "Mail"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password

# Option 2: AWS SES (Free tier: 62,000 emails/month when sending from EC2)
#   - Verify email identity in SES console
#   - Create SMTP credentials
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-ses-smtp-username
# SMTP_PASS=your-ses-smtp-password

# Option 3: Mailtrap (Development/Testing only)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-username
# SMTP_PASS=your-mailtrap-password

# Current configuration (fill these in):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@oppex.com

# ===================================
# FRONTEND CONFIGURATION
# ===================================
# URL where your frontend will be accessible (used in email verification links)
# Local Development: http://localhost:3001
# AWS EC2 (HTTP): http://YOUR-AWS-ELASTIC-IP
# AWS with Domain: http://yourdomain.com or https://yourdomain.com
FRONTEND_URL=http://localhost:3001

# ===================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ===================================
# Before deploying to AWS EC2:
# ☐ Generate strong SESSION_SECRET (32+ characters): openssl rand -base64 32
# ☐ Update FRONTEND_URL to AWS Elastic IP (e.g., http://54.123.45.67)
# ☐ Add AWS IP to CORS_ORIGINS (e.g., http://54.123.45.67)
# ☐ Configure SMTP with valid credentials (test email sending first)
# ☐ Verify Neon DB is accessible from AWS region
# ☐ Never commit .env file - keep it secure on server only
# ☐ Use HTTPS in production (set up SSL certificate with Let's Encrypt)
# ===================================
